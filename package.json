{
  "name": "quantum-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Markdown-first quantum course notes, published as a static GitHub Pages workbench.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch scripts/dev.mjs",
    "build:site": "node scripts/build.mjs",
    "build:pdf": "node scripts/pdf.mjs",
    "build": "npm run build:site && npm run build:pdf",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/content.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "new:note": "node scripts/new-note.mjs"
  },
  "dependencies": {
    "@mdit/plugin-katex": "^1.1.3",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-container": "^4.0.0",
    "mermaid": "^11.17.2",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  }
}
